#!/usr/bin/env php
<?php

use Filegator\Services\Auth\External\AccountStore;

require dirname(__DIR__) . '/vendor/autoload.php';
$options = getopt('', ['source:', 'database:', 'email-map:', 'apply']);
try {
    if (!isset($options['source'])) {
        throw new InvalidArgumentException('Usage: import-users --source=users.json [--database=accounts.sqlite] [--email-map=map.json] [--apply]');
    }
    $apply = isset($options['apply']);
    if ($apply && !isset($options['database'])) {
        throw new InvalidArgumentException('--apply requires --database');
    }
    $users = json_decode(file_get_contents($options['source']), true, 32, JSON_THROW_ON_ERROR);
    $map = isset($options['email-map']) ? json_decode(file_get_contents($options['email-map']), true, 32, JSON_THROW_ON_ERROR) : [];
    // Dry-run creates no persistent files and checks existing databases read-only.
    $path = $options['database'] ?? ':memory:';
    if (!$apply && !is_file($path)) {
        $path = ':memory:';
    }
    $store = new AccountStore($path, [], !$apply && $path !== ':memory:');
    echo json_encode(['dryRun' => !$apply, 'accounts' => $store->import($users, $map, !$apply)], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR) . "\n";
} catch (Throwable $error) {
    fwrite(STDERR, $error->getMessage() . "\n");
    exit(1);
}
